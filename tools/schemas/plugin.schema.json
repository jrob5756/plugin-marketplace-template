{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/jrob5756/plugin-marketplace-template/v0.2.0/tools/schemas/plugin.schema.json",
  "title": "Plugin manifest (source)",
  "description": "Declarative source-of-truth manifest for a plugin. Transpiled into Claude Code and GitHub Copilot plugin formats.",
  "type": "object",
  "required": ["name", "version", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Plugin identifier. Kebab-case, must match the parent directory name."
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.+-]+)?$" },
    "displayName": { "type": "string" },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "mcpServers": {
      "description": "MCP server definitions. Either a relative path to a `.mcp.json` file (preserved as an external file in Claude/Copilot output) OR an inline object using the same `{ mcpServers: { name: {...} } }` schema as Claude's .mcp.json. Inline is convenient for tiny plugins; path is preferred when the same config is consumed by external tooling.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\./",
          "description": "Relative path to .mcp.json file, e.g. './.mcp.json'."
        },
        {
          "type": "object",
          "required": ["mcpServers"],
          "additionalProperties": false,
          "properties": {
            "mcpServers": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/mcpServer" }
            }
          }
        }
      ]
    },
    "hooks": {
      "description": "Hook definitions. Either a relative path to a hooks.json file OR an inline object. NOTE: hooks are NOT portable to OpenCode (which has no declarative hooks format). Add `targets: [claude, copilot]` to make the target restriction explicit and silence the OpenCode warning.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\./",
          "description": "Relative path to hooks.json file, e.g. './hooks/hooks.json'."
        },
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^\\./" },
            "targets": {
              "type": "array",
              "items": { "enum": ["claude", "copilot", "opencode", "codex"] },
              "uniqueItems": true,
              "minItems": 1,
              "description": "Restrict hook emission to specific targets. Defaults to all targets that support declarative hooks."
            }
          }
        },
        {
          "type": "object",
          "not": { "required": ["path"] },
          "additionalProperties": true,
          "description": "Inline hooks object using the Claude Code hooks schema (event name -> array of matcher+hooks entries). Must NOT have a top-level `path` key (that form uses the {path, targets} branch above)."
        }
      ]
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" },
      "uniqueItems": true
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "description": "Codex CLI marketplace-display block. Maps to the `interface` field of the .codex-plugin/plugin.json manifest. The fields below are Codex-specific (no analog in other targets); displayName, developerName, and websiteURL are derived from the top-level plugin.displayName / author.name / homepage and cannot be overridden here. See docs/codex.md.",
      "properties": {
        "shortDescription": { "type": "string" },
        "longDescription": { "type": "string" },
        "category": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "privacyPolicyURL": { "type": "string", "format": "uri" },
        "termsOfServiceURL": { "type": "string", "format": "uri" },
        "defaultPrompt": {
          "oneOf": [
            { "type": "string", "maxLength": 128 },
            { "type": "array", "items": { "type": "string", "maxLength": 128 }, "minItems": 1, "maxItems": 3 }
          ]
        },
        "brandColor": { "type": "string", "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
        "composerIcon": { "type": "string" },
        "logo": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": ["name", "path", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": { "type": "string", "pattern": "^\\./" },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "argument-hint": { "type": "string" },
        "targets": {
          "type": "array",
          "items": { "enum": ["claude", "copilot", "opencode", "codex"] },
          "uniqueItems": true,
          "minItems": 1,
          "description": "Restrict agent emission to specific targets. Defaults to all targets that support agents in their plugin format. Use this to silence the Codex warning when an agent is intentionally Claude/Copilot/OpenCode-only (Codex loads subagents from .codex/agents/, not from plugin manifests)."
        },
        "claude": { "$ref": "#/$defs/agentClaude" },
        "copilot": { "$ref": "#/$defs/agentCopilot" },
        "opencode": { "$ref": "#/$defs/agentOpencode" },
        "codex": { "$ref": "#/$defs/agentCodex" }
      }
    },
    "agentClaude": {
      "type": "object",
      "additionalProperties": true,
      "description": "Claude Code agent frontmatter. Strict-keyed fields are validated; unknown fields pass through verbatim so authors can use newly-released Claude features without waiting for a schema update.",
      "properties": {
        "model": { "type": "string" },
        "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "not": { "pattern": "\\*" }
          },
          "description": "Allowed tools. Omit entirely to inherit all tools. Globs (server/*) are NOT supported on Claude — list each tool by name, or omit the field."
        },
        "disallowedTools": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "memory": { "type": "string", "enum": ["user", "project", "local"] },
        "background": { "type": "boolean" },
        "isolation": { "type": "string", "enum": ["worktree"] },
        "color": {
          "type": "string",
          "description": "Display color. Spec accepts red/blue/green/yellow/purple/orange/pink/cyan, but we allow any string so authors can use hex (e.g. '#6965db') or extended names; unsupported values are silently ignored by Claude."
        }
      }
    },
    "agentCopilot": {
      "type": "object",
      "additionalProperties": true,
      "description": "GitHub Copilot agent frontmatter. Strict-keyed fields are validated; unknown fields pass through.",
      "properties": {
        "model": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed tools. Supports server/* glob syntax."
        },
        "agents": {
          "oneOf": [
            { "const": "*" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "user-invocable": { "type": "boolean" },
        "disable-model-invocation": { "type": "boolean" },
        "target": { "type": "string", "enum": ["vscode", "github-copilot"] }
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "path", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "path": { "type": "string", "pattern": "^\\./" },
        "description": { "type": "string", "minLength": 10, "maxLength": 1024 },
        "argument-hint": { "type": "string" },
        "claude": { "$ref": "#/$defs/skillClaude" },
        "copilot": { "$ref": "#/$defs/skillCopilot" },
        "opencode": { "$ref": "#/$defs/skillOpencode" },
        "codex": { "$ref": "#/$defs/skillCodex" }
      }
    },
    "skillClaude": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "disable-model-invocation": { "type": "boolean" }
      }
    },
    "skillCopilot": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "user-invocable": { "type": "boolean" },
        "disable-model-invocation": { "type": "boolean" },
        "context": { "type": "string", "enum": ["inline", "fork"] }
      }
    },
    "agentOpencode": {
      "type": "object",
      "additionalProperties": true,
      "description": "OpenCode-specific overrides. Strict-keyed fields are validated; unknown fields pass through. See docs/opencode.md.",
      "properties": {
        "mode": { "type": "string", "enum": ["primary", "subagent", "all"] },
        "model": { "type": "string", "description": "provider/model-id (e.g. anthropic/claude-sonnet-4-5)." },
        "variant": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "steps": { "type": "integer", "minimum": 1 },
        "hidden": { "type": "boolean" },
        "color": { "type": "string" },
        "disable": { "type": "boolean" },
        "permission": {
          "type": "object",
          "description": "Per-agent permission overrides. See docs/opencode.md#permissions.",
          "additionalProperties": true
        }
      }
    },
    "skillOpencode": {
      "type": "object",
      "additionalProperties": true,
      "description": "OpenCode-specific skill overrides. Strict-keyed fields are validated; unknown fields pass through. See docs/opencode.md.",
      "properties": {
        "license": { "type": "string" },
        "compatibility": { "type": "string" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "agentCodex": {
      "type": "object",
      "additionalProperties": true,
      "description": "Codex CLI-specific agent overrides. Strict-keyed fields are validated; unknown fields pass through. See docs/codex.md.",
      "properties": {
        "model": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "skillCodex": {
      "type": "object",
      "additionalProperties": true,
      "description": "Codex CLI-specific skill overrides. Strict-keyed fields are validated; unknown fields pass through. See docs/codex.md."
    },
    "mcpServer": {
      "type": "object",
      "description": "A single MCP server entry. Either stdio (command + optional args/env) or remote (url + optional headers).",
      "oneOf": [
        {
          "type": "object",
          "required": ["command"],
          "additionalProperties": true,
          "properties": {
            "type": { "enum": ["stdio", "local"] },
            "command": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "cwd": { "type": "string" }
          },
          "not": { "required": ["url"] }
        },
        {
          "type": "object",
          "required": ["url"],
          "additionalProperties": true,
          "properties": {
            "type": { "enum": ["http", "sse", "ws", "remote"] },
            "url": { "type": "string", "format": "uri" },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "not": { "required": ["command"] }
        }
      ]
    }
  }
}
